# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored — never commit real credentials.

# Gmail account that SENDS the reservation emails.
GMAIL_USER=

# 16-character Google App Password for GMAIL_USER (NOT your normal Gmail password).
# Create one at https://myaccount.google.com/apppasswords (requires 2-Step Verification).
# Spaces are fine — they are removed automatically.
GMAIL_APP_PASSWORD=

# Inbox that RECEIVES new reservation requests.
OWNER_EMAIL=rudra300806@gmail.com

# Optional: save every reservation as a row in a Google Sheet.
# Web app URL of the Apps Script in scripts/google-apps-script.gs (ends in /exec).
# Leave empty to turn this off.
GOOGLE_SHEETS_WEBHOOK_URL=
# Any long random string; must match SECRET in the Apps Script.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
GOOGLE_SHEETS_SECRET=

# Optional: 465 (SSL, default) or 587 (STARTTLS).
SMTP_PORT=465

# Optional, advanced: another SMTP server instead of Gmail. Leave empty for Gmail.
SMTP_HOST=

# Owner notification for each booking: "each" (default) or "off".
# "off" relies on the Google Sheet; the owner is still emailed if a booking can't be saved there.
OWNER_NOTIFY=each

# Optional backup email provider, used when Gmail fails or hits its daily limit.
# Example for Brevo (Settings → SMTP & API): host smtp-relay.brevo.com, port 587,
# user = your Brevo SMTP login, pass = an SMTP key, from = a sender verified in Brevo.
FALLBACK_SMTP_HOST=
FALLBACK_SMTP_PORT=587
FALLBACK_SMTP_USER=
FALLBACK_SMTP_PASS=
FALLBACK_FROM_EMAIL=

# Optional but recommended: Cloudflare Turnstile spam check on the reservation form.
# Free at https://dash.cloudflare.com → Turnstile → Add widget (add your domain and localhost).
# Set BOTH or neither. For local testing, Cloudflare's always-pass test keys are:
#   site key 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional but recommended on Vercel: Upstash Redis, so rate limits are shared by all
# server instances (without it, each instance counts on its own).
# Free at https://upstash.com, or Vercel → Storage → Upstash (which sets KV_REST_API_URL /
# KV_REST_API_TOKEN automatically — those work too).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: public URL of the deployed site, used for SEO / Open Graph tags
# and for the "Change or cancel booking" links in guest emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: secret used to sign the "Change or cancel booking" links in guest emails.
# Defaults to GOOGLE_SHEETS_SECRET. Changing it makes links in emails already sent stop working.
BOOKING_LINK_SECRET=

# Optional: WhatsApp notifications through the WhatsApp Cloud API (Meta). See README → "WhatsApp setup".
# Leave WHATSAPP_TOKEN empty to turn WhatsApp off; email keeps working either way.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# The owner's WhatsApp number for new-booking alerts, e.g. +91 98765 43210. Empty = no owner alerts.
WHATSAPP_OWNER_NUMBER=
# Language code the message templates were approved in (en, en_US, gu, hi …).
WHATSAPP_TEMPLATE_LANG=en
# "true" shows the "send updates on WhatsApp" checkbox on the form (guests must opt in).
NEXT_PUBLIC_WHATSAPP_OPT_IN=false

# Owner admin at /admin: edit the menu and events. At least 10 characters. Empty = admin off.
# Generate one with: node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
ADMIN_PASSWORD=
# Optional: where admin changes are saved — "sheets", "redis" or "file". Picked automatically when empty
# (Upstash Redis → Google Sheet → local .data/ file). Use "file" to try the admin without touching the live sheet.
SITE_CONTENT_STORE=
